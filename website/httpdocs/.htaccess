# leyonet.ch – Auftritt (Apache bzw. Plesk mit nginx + Apache)
# HTTPS erzwingen und www auf die Hauptadresse umleiten
RewriteEngine On
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://leyonet.ch%{REQUEST_URI} [R=301,L]

ErrorDocument 404 /404.html

# Keine Verzeichnislisten, keine versteckten Dateien ausliefern
Options -Indexes
<FilesMatch "^\.">
  Require all denied
</FilesMatch>
# Vorlagen mit Platzhaltern nicht ausliefern (echte Seiten liegen nur auf dem Server)
<FilesMatch "\.vorlage\.html$">
  Require all denied
</FilesMatch>

<IfModule mod_headers.c>
  # Nur eigene Dateien, keine fremden Server, keine Einbettung
  Header always set Content-Security-Policy "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self' data:; manifest-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Referrer-Policy "no-referrer"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=()"
  Header always set Cross-Origin-Opener-Policy "same-origin"
  Header always set Cross-Origin-Resource-Policy "same-origin"

  # Bilder, Schrift und Skripte lange zwischenspeichern, Seiten kurz
  <FilesMatch "\.(webp|png|svg|css|js)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  # Downloads immer als Datei
  <FilesMatch "^leyonet\.html$">
    Header set Content-Disposition "attachment; filename=leyonet.html"
  </FilesMatch>
</IfModule>

AddType image/webp .webp
AddType application/x-apple-diskimage .dmg
AddType application/vnd.debian.binary-package .deb
AddType application/x-rpm .rpm
AddType application/octet-stream .AppImage .msi

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml
</IfModule>

# leyonet.ch: statische Website (Apache in Plesk). Gleiche Regeln wie im <meta>-Tag der Seite,
# dazu Schutz vor Einbetten und MIME-Raten. Ohne mod_headers wirkt nur das <meta>-Tag.
<IfModule mod_headers.c>
  Header always set Content-Security-Policy "default-src 'none'; img-src 'self'; style-src 'unsafe-inline'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "no-referrer"
  Header always set X-Frame-Options "DENY"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>
Options -Indexes

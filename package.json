{
  "name": "leyonet",
  "private": true,
  "version": "1.6.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json && tsc -p tsconfig.core.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "wiki": "node scripts/erzeugen.mjs wiki",
    "schaufenster": "node scripts/erzeugen.mjs schaufenster",
    "verify": "npm run check && npm test && npm run test:server && npm run build",
    "e2e": "npm run build && playwright test",
    "release": "npm run verify && npm run sicherheit && node scripts/release.mjs",
    "sicherheit": "node scripts/sicherheit/angriff.mjs",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build",
    "tauri": "tauri",
    "test:server": "node --test server/app.test.cjs server/limits.test.cjs server/beta.test.cjs server/haertung.test.cjs",
    "arbeitsblaetter": "node scripts/arbeitsblaetter/erzeugen.mjs",
    "server": "node server/start.cjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tauri-apps/cli": "^2.12.4",
    "@tsconfig/svelte": "^5.0.9",
    "@types/node": "^26.6.6",
    "pdf-lib": "1.17.1",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^5.1.0"
  },
